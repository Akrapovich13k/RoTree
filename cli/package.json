{
  "name": "@rotree/cli",
  "version": "0.1.1",
  "description": "Local CLI for RoTree — run `rotree serve` to bridge Roblox Studio to your workspace.",
  "license": "MIT",
  "bin": {
    "rotree": "out/index.js"
  },
  "files": [
    "out",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "tsc --noEmit",
    "start": "node out/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --minify --outfile=dist/rotree.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rotree/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  }
}
