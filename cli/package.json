{
  "name": "@rotree/cli",
  "version": "0.1.0",
  "description": "Local CLI for RoTree — run `rotree serve` to bridge Roblox Studio to your workspace.",
  "license": "MIT",
  "bin": {
    "rotree": "out/index.js"
  },
  "files": ["out"],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "tsc --noEmit",
    "start": "node out/index.js"
  },
  "dependencies": {
    "@rotree/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0"
  }
}
