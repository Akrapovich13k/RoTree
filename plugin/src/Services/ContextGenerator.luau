--!strict
-- Builds AI_CONTEXT.md. The same algorithm runs on the extension side, but
-- having a Studio-side version means the user gets a meaningful Markdown file
-- even before VS Code re-renders.

local ContextGenerator = {}

export type Input = {
	placeName: string,
	placeId: number,
	pluginVersion: string,
	tree: any,
	scripts: { any },
	remotes: { any },
	gui: { any },
	stats: { [string]: number },
}

local function listTop(items: { any }, key: string, max: number): { string }
	local out: { string } = {}
	for i = 1, math.min(max, #items) do
		table.insert(out, "- " .. tostring(items[i][key]))
	end
	return out
end

local function joinLines(t: { string }): string
	return table.concat(t, "\n")
end

function ContextGenerator.Build(input: Input): string
	local lines: { string } = {}
	table.insert(lines, "# AI context for " .. input.placeName)
	table.insert(lines, "")
	local version = input.pluginVersion or "?"
	table.insert(lines, "_Generated by RoTree v" .. version .. " on " .. os.date("!%Y-%m-%d %H:%M:%S UTC") .. "_")
	table.insert(lines, "")
	table.insert(lines, "## Overview")
	table.insert(lines, "")
	table.insert(lines, string.format("- Place: **%s** (id %d)", input.placeName, input.placeId))
	for k, v in input.stats do
		table.insert(lines, string.format("- %s: **%d**", k:sub(1, 1):upper() .. k:sub(2), v))
	end
	table.insert(lines, "")

	-- Services
	table.insert(lines, "## Services used")
	table.insert(lines, "")
	if typeof(input.tree) == "table" then
		for _, node in input.tree do
			if typeof(node) == "table" and node.name then
				table.insert(lines, "- `" .. node.name .. "`")
			end
		end
	end
	table.insert(lines, "")

	-- Server scripts
	local serverScripts: { any } = {}
	local clientScripts: { any } = {}
	local modules: { any } = {}
	for _, s in input.scripts do
		if s.className == "Script" then table.insert(serverScripts, s)
		elseif s.className == "LocalScript" then table.insert(clientScripts, s)
		elseif s.className == "ModuleScript" then table.insert(modules, s) end
	end

	table.insert(lines, "## Server scripts")
	table.insert(lines, "")
	if #serverScripts == 0 then
		table.insert(lines, "_None._")
	else
		for _, s in serverScripts do
			table.insert(lines, string.format("- `%s` (%d lines)", s.fullPath, s.lines or 0))
		end
	end
	table.insert(lines, "")

	table.insert(lines, "## Client scripts")
	table.insert(lines, "")
	if #clientScripts == 0 then
		table.insert(lines, "_None._")
	else
		for _, s in clientScripts do
			table.insert(lines, string.format("- `%s` (%d lines)", s.fullPath, s.lines or 0))
		end
	end
	table.insert(lines, "")

	table.insert(lines, "## ModuleScripts")
	table.insert(lines, "")
	if #modules == 0 then
		table.insert(lines, "_None._")
	else
		for _, s in modules do
			table.insert(lines, string.format("- `%s` (%d lines)", s.fullPath, s.lines or 0))
		end
	end
	table.insert(lines, "")

	table.insert(lines, "## Remotes")
	table.insert(lines, "")
	if #input.remotes == 0 then
		table.insert(lines, "_None._")
	else
		for _, r in input.remotes do
			table.insert(lines, string.format("- `%s` — %s", r.fullPath, r.className))
		end
	end
	table.insert(lines, "")

	table.insert(lines, "## GUI")
	table.insert(lines, "")
	if #input.gui == 0 then
		table.insert(lines, "_None._")
	else
		for _, g in input.gui do
			if g.className == "ScreenGui" then
				table.insert(lines, string.format("- `%s` (ScreenGui)", g.fullPath))
			end
		end
	end
	table.insert(lines, "")

	table.insert(lines, "## How your AI should use this")
	table.insert(lines, "")
	table.insert(lines, "Read `.rotree/game-tree.json` for the structure, `.rotree/scripts-map.json` for full source, `.rotree/remotes-map.json` for the remote surface. Do NOT modify the live game — instead, write proposed changes into `.rotree/patches/<name>.json` and ask the user to apply them via RoTree → Apply Patch.")
	table.insert(lines, "")
	table.insert(lines, "Critical systems (DataStore, leaderstats, MarketplaceService, anti-cheat) require double confirmation in the plugin — write patches conservatively.")

	return joinLines(lines)
end

return ContextGenerator
